generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ContactLead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  website   String?
  budget    String?
  message   String?  @db.Text
  type      String   @default("cotizacion")
  status    String   @default("nuevo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                 Int             @id @default(autoincrement())
  email              String          @unique
  password           String
  name               String
  company            String?
  phone              String?
  plan               String?
  active             Boolean         @default(true)
  domainName         String?
  hostingProvider    String?
  hostingRenewal     DateTime?
  domainRenewal      DateTime?
  serviceNotes       String?         @db.Text
  monthlyFee         Float?
  hostingCost        Float?
  domainCost         Float?
  domainPaidByClient Boolean         @default(false)
  activeServices     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  metrics            Metric[]
  payments           Payment[]
  meetings           Meeting[]
  files              ClientFile[]
  tickets            Ticket[]
  tasks              Task[]
  services           ClientService[]
}

model ClientService {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  type          String    @default("mensual")
  amount        Float     @default(0)
  active        Boolean   @default(true)
  renewalDate   DateTime?
  firstYearFree Boolean   @default(false)
  paidBy        String?
  notes         String?   @db.Text
  saleDate      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Metric {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  platform    String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  roas        Float    @default(0)
  createdAt   DateTime @default(now())
}

model Payment {
  id          Int       @id @default(autoincrement())
  clientId    Int
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String    @default("CLP")
  status      String    @default("pendiente")
  description String?
  invoiceUrl  String?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Meeting {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  duration    Int      @default(60)
  meetLink    String?
  status      String   @default("programada")
  createdAt   DateTime @default(now())
}

model ClientFile {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  category     String   @default("general")
  size         Int
  mimeType     String
  createdAt    DateTime @default(now())
}

model Ticket {
  id        Int             @id @default(autoincrement())
  clientId  Int
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject   String
  status    String          @default("abierto")
  priority  String          @default("normal")
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Task {
  id        Int       @id @default(autoincrement())
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  priority  String    @default("normal")
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model WebExpressOrder {
  id             Int      @id @default(autoincrement())
  orderId        String   @unique
  status         String   @default("nuevo")
  businessName   String
  email          String
  phone          String?
  city           String?
  address        String?
  whatsapp       String?
  socials        String?
  hasDomain      String?
  brandColors    String?
  products       String   @db.Text
  about          String?  @db.Text
  mission        String?
  vision         String?
  visualStyle    String?
  logoName       String?
  photosNames    String?  @db.Text
  clientId       Int?
  // Landing "Tu Sitio Web Profesional" (compra online / WhatsApp) — ver seoLocalPages/App para contexto de rutas
  modalidad      String? // 'online' | 'whatsapp'
  contactName    String?
  rut            String?
  razonSocial    String?
  rubro          String?
  secciones      String?  @db.Text // JSON array de secciones elegidas
  region         String?
  publicEmail    String?
  wantsMaps      Boolean  @default(false)
  domainWanted   String?
  domainExisting String?
  wantsStore     Boolean  @default(false)
  productCount   String? // '1-10' | '11-25' | '25+'
  hasMercadoPago String? // 'si' | 'no'
  montoNeto      Float?
  montoIva       Float?
  montoTotal     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Borrador del wizard /sitio-web guardado para retomar en otro dispositivo
// (link enviado por WhatsApp o correo). No contiene archivos (logo/fotos) —
// esos se vuelven a adjuntar si corresponde al retomar.
model WebOrderDraft {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  step      Int      @default(1)
  data      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

// Analítica propia del sitio — visitas por página y eventos (clics WhatsApp,
// envíos de formulario, pasos del wizard /sitio-web). Ver docs/superpowers/specs/2026-09-13-analitica-propia-design.md
model AnalyticsPageView {
  id        Int      @id @default(autoincrement())
  path      String
  visitorId String
  device    String // "mobile" | "tablet" | "desktop"
  referrer  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([path])
  @@index([visitorId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  eventName String // "whatsapp_click" | "form_submit" | "lead_click" | "wizard_step" | "checkout_iniciado"
  path      String
  visitorId String
  label     String?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([path])
  @@index([createdAt])
}

model Licitacion {
  id                Int      @id @default(autoincrement())
  entidad           String
  numero            String?
  descripcion       String
  monto             Float    @default(0)
  fechaAdjudicacion DateTime
  notas             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
