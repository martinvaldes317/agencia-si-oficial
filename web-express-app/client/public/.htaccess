<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Páginas de letreros y publicidad corporativa migradas a publicidadtalca.cl (2026-09)
  RewriteRule ^(letreros|publicidad-corporativa)(/.*)?$ https://publicidadtalca.cl/ [R=301,L]
  # Marketing digital por ciudad: ya no se ofrece como página local
  RewriteRule ^marketing(/.*)?$ https://agenciasi.cl/ [R=301,L]
  # Diagnóstico SEO gratuito: ya no se ofrece
  RewriteRule ^diagnostico-seo/?$ https://agenciasi.cl/ [R=301,L]
  # Las reglas para prefijos "atrapados" por sus propias subpáginas (/agencia,
  # /servicios, etc. — ver el bloque "Auto-redirect" en generate-seo-html.cjs)
  # se agregan solas en cada build, justo debajo de esta línea.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
